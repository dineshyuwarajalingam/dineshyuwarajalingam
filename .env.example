NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/mydb?schema=public"

# Card provider switch: 'marqeta' | 'clowd9'
CARD_PROVIDER=clowd9

# Marqeta
MARQETA_TIMEOUT_SECONDS=3000

# Clowd9 (UAT non-production)
CLOWD9_KEY=your-api-key-here
CLOWD9_SECRET=your-api-secret-here
CLOWD9_PRODUCT_ID=your-product-id-here
CLOWD9_CLIENT_ID=your-client-id-here
CLOWD9_CARD_MANUFACTURER_ID=your-card-manufacturer-id-here
CLOWD9_TIMEOUT_SECONDS=5000
